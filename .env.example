# Database
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5431/nuxt_project_management?schema=public"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — required for Continue with Google on sign-in / sign-up.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origin: http://localhost:3000
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — local testing can use onboarding@resend.dev (delivers only to your Resend account email).
# Set RESEND_TEST_TO to that same inbox so invites to other people still arrive while testing.
# For production, verify a domain at https://resend.com/domains and set RESEND_FROM to that address.
RESEND_API_KEY=""
RESEND_FROM="Northstar <onboarding@resend.dev>"
RESEND_TEST_TO=""

# UploadThing — the NUXT_ prefix is required by the Nuxt module.
# Create an app token at https://uploadthing.com/dashboard
NUXT_UPLOADTHING_TOKEN=""
UPLOADTHING_TOKEN=""

# Stripe — test keys from https://dashboard.stripe.com/apikeys
# Hosted Checkout uses the secret key. The publishable key is optional.
# For local webhooks: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
