generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  emailVerified     Boolean  @default(false) @map("email_verified")
  name              String?
  image             String?
  activeWorkspaceId String?  @map("active_workspace_id")
  activeProjectId   String?  @map("active_project_id")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  sessions           Session[]
  accounts           Account[]
  memberships        WorkspaceMember[]
  projectMemberships ProjectMember[]
  createdInvites     WorkspaceInvite[]
  createdWorkspaces  Workspace[]       @relation("CreatedWorkspaces")
  createdProjects    Project[]         @relation("CreatedProjects")
  createdTasks       Task[]            @relation("CreatedTasks")
  assignedTasks      Task[]            @relation("AssignedTasks")
  taskComments       TaskComment[]
  attachments        Attachment[]
  taskLikes          TaskLike[]
  taskMemberships    TaskMember[]
  activities         Activity[]
  createdLabels      Label[]
  sentEmails         EmailLog[]        @relation("CreatedEmails")

  activeWorkspace Workspace? @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id])
  activeProject   Project?   @relation("ActiveProject", fields: [activeProjectId], references: [id])

  @@map("users")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  emailLogs   EmailLog[]
  activities  Activity[]
  projects    Project[]         @relation("Projects")
  settings    WorkspaceSetting?
  creator     User              @relation("CreatedWorkspaces", fields: [createdBy], references: [id], onDelete: Cascade)
  activeUsers User[]            @relation("ActiveWorkspace") // inverse of User.activeWorkspace

  @@map("workspaces")
}

model WorkspaceSetting {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique @map("workspace_id")
  emailOnInvite      Boolean  @default(true) @map("email_on_invite")
  emailOnProjectAdd  Boolean  @default(true) @map("email_on_project_add")
  weekStartsOnMonday Boolean  @default(true) @map("week_starts_on_monday")
  backgroundColor    String?  @map("background_color")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

model WorkspaceMember {
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())

  // Relationships
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  email       String?
  role        String    @default("MEMBER")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_invites")
}

model ProjectMember {
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  role      String   @default("MEMBER")
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_members")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  archivedAt  DateTime? @map("archived_at")
  workspaceId String    @map("workspace_id")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  creator     User            @relation("CreatedProjects", fields: [createdBy], references: [id], onDelete: Cascade)
  workspace   Workspace       @relation("Projects", fields: [workspaceId], references: [id], onDelete: Cascade)
  activeUsers User[]          @relation("ActiveProject") // inverse of User.activeProject
  members     ProjectMember[]
  columns     TaskColumn[]
  tasks       Task[]
  labels      Label[]
  emailLogs   EmailLog[]
  activities  Activity[]

  @@map("projects")
}

model TaskColumn {
  id         String    @id @default(cuid())
  name       String
  order      Int       @default(0)
  color      String?
  archivedAt DateTime? @map("archived_at")
  projectId  String    @map("project_id")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relationships
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("task_columns")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  order       Int       @default(0)
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  completedAt DateTime? @map("completed_at")
  dueDate     DateTime? @map("due_date")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  coverColor  String?   @map("cover_color")
  archivedAt  DateTime? @map("archived_at")
  columnId    String    @map("column_id")
  projectId   String    @map("project_id")
  createdBy   String    @map("created_by")
  assigneeId  String?   @map("assignee_id")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  column     TaskColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator    User           @relation("CreatedTasks", fields: [createdBy], references: [id], onDelete: Cascade)
  assignee   User?          @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments   TaskComment[]
  likes      TaskLike[]
  members    TaskMember[]
  taskLabels TaskLabel[]
  activities Activity[]

  @@index([columnId, archivedAt, order], map: "tasks_column_id_archived_at_order_idx")
  @@index([columnId, archivedAt, status, completedAt], map: "tasks_column_id_archived_at_status_completed_at_idx")
  @@index([projectId, archivedAt, createdAt], map: "tasks_project_id_archived_at_createdAt_idx")
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model Attachment {
  id             String   @id @default(cuid())
  name           String
  url            String   @db.Text
  fileKey        String?  @map("file_key")
  size           Int?
  mimeType       String?  @map("mime_type")
  attachableType String   @map("attachable_type")
  attachableId   String   @map("attachable_id")
  uploadedBy     String   @map("uploaded_by")
  createdAt      DateTime @default(now())

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([attachableType, attachableId])
  @@map("attachments")
}

model TaskLike {
  userId    String   @map("user_id")
  taskId    String   @map("task_id")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@map("task_likes")
}

model TaskMember {
  taskId  String   @map("task_id")
  userId  String   @map("user_id")
  addedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_members")
}

model Label {
  id        String   @id @default(cuid())
  name      String
  color     String
  projectId String   @map("project_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id")
  labelId String @map("label_id")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

// Workspace-scoped event log. projectId and taskId are optional so the same
// table can record list, project, and workspace events — not only card history.
model Activity {
  id          String   @id @default(cuid())
  type        String
  message     String   @db.Text
  metadata    Json?
  workspaceId String   @map("workspace_id")
  projectId   String?  @map("project_id")
  taskId      String?  @map("task_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@map("activities")
}

model EmailLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String?  @map("project_id")
  template    String
  subject     String
  toEmail     String   @map("to_email")
  fromEmail   String   @map("from_email")
  html        String   @db.Text
  text        String?  @db.Text
  status      String
  error       String?  @db.Text
  resendId    String?  @map("resend_id")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator   User?     @relation("CreatedEmails", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([projectId])
  @@map("email_logs")
}

// The three models below back Better Auth. Field names must stay as Better Auth
// expects them, but the columns are mapped to snake_case to match every other
// table in this schema.
model Session {
  id        String   @id
  token     String
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
