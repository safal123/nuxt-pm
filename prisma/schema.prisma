generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  clerkId           String   @unique
  email             String   @unique
  name              String?
  clerkObject       Json?
  activeWorkspaceId String?  @map("active_workspace_id")
  activeProjectId   String?  @map("active_project_id")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  memberships        WorkspaceMember[]
  projectMemberships ProjectMember[]
  createdInvites     WorkspaceInvite[]
  createdWorkspaces  Workspace[]       @relation("CreatedWorkspaces")
  createdProjects   Project[]         @relation("CreatedProjects")
  createdTasks      Task[]            @relation("CreatedTasks")
  assignedTasks     Task[]            @relation("AssignedTasks")
  taskComments      TaskComment[]
  taskAttachments   TaskAttachment[]
  taskLikes         TaskLike[]
  taskMemberships   TaskMember[]
  taskActivities    TaskActivity[]
  createdLabels     Label[]

  activeWorkspace Workspace? @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id])
  activeProject   Project?   @relation("ActiveProject", fields: [activeProjectId], references: [id])

  @@map("users")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  projects    Project[]         @relation("Projects")
  creator     User              @relation("CreatedWorkspaces", fields: [createdBy], references: [id], onDelete: Cascade)
  activeUsers User[]            @relation("ActiveWorkspace") // inverse of User.activeWorkspace

  @@map("workspaces")
}

model WorkspaceMember {
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())

  // Relationships
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  email       String?
  role        String    @default("MEMBER")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_invites")
}

model ProjectMember {
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  role      String   @default("MEMBER")
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_members")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  workspaceId String   @map("workspace_id")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  creator     User            @relation("CreatedProjects", fields: [createdBy], references: [id], onDelete: Cascade)
  workspace   Workspace       @relation("Projects", fields: [workspaceId], references: [id], onDelete: Cascade)
  activeUsers User[]          @relation("ActiveProject") // inverse of User.activeProject
  members     ProjectMember[]
  columns     TaskColumn[]
  tasks       Task[]
  labels      Label[]

  @@map("projects")
}

model TaskColumn {
  id         String    @id @default(cuid())
  name       String
  order      Int       @default(0)
  color      String?
  archivedAt DateTime? @map("archived_at")
  projectId  String    @map("project_id")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relationships
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("task_columns")
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  order        Int       @default(0)
  priority     String    @default("MEDIUM")
  status       String    @default("TODO")
  completedAt  DateTime? @map("completed_at")
  dueDate      DateTime? @map("due_date")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  coverColor   String?   @map("cover_color")
  columnId     String    @map("column_id")
  projectId    String    @map("project_id")
  createdBy    String    @map("created_by")
  assigneeId   String?   @map("assignee_id")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  column      TaskColumn       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User             @relation("CreatedTasks", fields: [createdBy], references: [id], onDelete: Cascade)
  assignee    User?            @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  attachments TaskAttachment[]
  likes       TaskLike[]
  members     TaskMember[]
  taskLabels  TaskLabel[]
  activities  TaskActivity[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model TaskAttachment {
  id         String   @id @default(cuid())
  name       String
  url        String
  size       Int?
  mimeType   String?  @map("mime_type")
  taskId     String   @map("task_id")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("task_attachments")
}

model TaskLike {
  userId    String   @map("user_id")
  taskId    String   @map("task_id")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@map("task_likes")
}

model TaskMember {
  taskId  String   @map("task_id")
  userId  String   @map("user_id")
  addedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_members")
}

model Label {
  id        String   @id @default(cuid())
  name      String
  color     String
  projectId String   @map("project_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id")
  labelId String @map("label_id")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model TaskActivity {
  id        String   @id @default(cuid())
  type      String
  message   String   @db.Text
  metadata  Json?
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_activities")
}
